# ── Bybit API ─────────────────────────────────────
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here
USE_TESTNET=true               # Set to false for live trading

# ── Trading Settings ──────────────────────────────
SYMBOLS=BTC/USDT,XRP/USDT,MNT/USDT
TIMEFRAMES=15m,30m,1h
MIN_TIMEFRAME_CONFLUENCE=1
MARKET_TYPE=swap               # spot or swap
CANDLE_LIMIT=250
LOOP_INTERVAL=300             # seconds

# ── Risk Management ───────────────────────────────
MAX_RISK_PER_TRADE=0.01        # 1% of balance per trade
STOP_LOSS_PCT=0.02             # 2% stop loss
TAKE_PROFIT_PCT=0.04           # 4% take profit (2:1 R:R)

# ── Indicator Settings ───────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_FAST=20
EMA_SLOW=50
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
MIN_SIGNAL_CONFLUENCE=3

# ── Telegram Alerts ───────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Claude AI Sentiment (optional) ───────────────
SENTIMENT_ENABLED=false        # Set to true to enable
ANTHROPIC_API_KEY=your_anthropic_key_here
CRYPTOPANIC_KEY=your_cryptopanic_key_here

# ── Google Gemini (for trade analysis) ────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_ENABLED=false           # Set to true to enable
GEMINI_MIN_CONFIDENCE=70

# ── LangChain AI Agent Configuration ──────────────
LLM_PROVIDER=anthropic         # anthropic, openai, or google
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=2048
CLAUDE_TEMPERATURE=0.7
AGENT_TEMPERATURE=0.7
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300              # 5 minutes

# ── RAG & Vector Database ────────────────────────
RAG_ENABLED=true
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL=default        # Uses Chroma's default (all-MiniLM-L6-v2)

# ── Conversation Memory ──────────────────────────
CONVERSATION_MEMORY_TYPE=buffer
MAX_CONVERSATION_HISTORY=10
MEMORY_MAX_TOKENS=4000

# ── News API ─────────────────────────────────────
NEWS_API_ENABLED=true
NEWS_API_KEY=your_newsapi_key_here   # Optional: from newsapi.org
API_RATE_LIMIT_PER_MINUTE=60

# ── AI System Configuration ──────────────────────
LANGCHAIN_DEBUG=false          # Set true for verbose LangChain logging
LOG_AGENT_DECISIONS=true
LOG_TOOL_CALLS=true

# ── Logging ───────────────────────────────────────
LOG_FILE=bot.log
LOG_LEVEL=INFO
